    "type": "git",
    "url": "git+https://github.com/caribeedu/roboratory.git"
  },
  "bugs": {
    "url": "https://github.com/caribeedu/roboratory/issues"
  },
  "author": {
    "name": "Edu Caribé"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "cli": "node tools/cli.mjs",
    "package": "electron-forge package",
