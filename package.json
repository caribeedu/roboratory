{
  "name": "roboratory",
  "productName": "Roboratory",
  "version": "0.10.0",
  "description": "A factory for AI agents: deterministic production lines in pixel art.",
  "keywords": [
    "ai-agents",
    "agents",
    "workflow",
    "orchestration",
    "electron",
    "pixel-art",
    "claude-code",
    "llm"
  ],
  "homepage": "https://github.com/caribeedu/roboratory",
